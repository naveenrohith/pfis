# PFIS Configuration
# Local Supabase PostgreSQL (created by `npm run supabase:start`)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
APP_NAME=PFIS
APP_VERSION=0.1.0
DEBUG=true
# Generate strong secrets, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY must not stay at the built-in default outside local/demo use.
SECRET_KEY=change-me-in-production-with-at-least-32-characters
# Optional: a Fernet key (base64, 32 bytes). If blank it is derived from SECRET_KEY.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=43200
AUTH_REQUIRED=true
SESSION_COOKIE_NAME=pfis_session
CSRF_COOKIE_NAME=pfis_csrf
OAUTH_COOKIE_NAME=pfis_oauth
SESSION_COOKIE_SECURE=false
SESSION_ABSOLUTE_HOURS=24
SESSION_IDLE_MINUTES=60
PASSWORD_MIN_LENGTH=12
ALLOW_DEMO_LOGIN=true
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_MESSAGE_BYTES=256
DEMO_USER_PASSWORD=change-demo-password

# Gmail OAuth (Phase 1)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/gmail/callback
# GOOGLE_ALLOWED_EMAILS=naveenrohith2056@gmail.com

# Hosted Supabase PostgreSQL (set the real value only in your secret manager)
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# SESSION_COOKIE_NAME=__Host-pfis_session
# SESSION_COOKIE_SECURE=true
# ALLOW_DEMO_LOGIN=false
# CORS_ORIGINS=https://pfis.example.com
